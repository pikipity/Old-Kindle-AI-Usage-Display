# ============================================================
# Kindle AI 用量仪表盘 · 统一配置
# 安装时把下面的占位值改成真实值：服务器端填前 3 项，Kindle 端填 IMAGE_URL
# 格式要求：KEY=VALUE，等号两侧无空格、值不要加引号（Kindle 端要 source 本文件）
# 填完后建议在本地仓库执行：git update-index --skip-worktree config.env
# ============================================================

# ---------- 服务器端必填 ----------
# Kimi Code API Key，在 Kimi Code 控制台创建（https://www.kimi.com/code/console）
# 注意：与 Kimi 开放平台的 Key 不通用
KIMI_CODE_API_KEY=
# DeepSeek 开放平台 API Key，在 https://platform.deepseek.com 控制台创建
DEEPSEEK_API_KEY=
# 服务器上的中文字体路径（Debian/Ubuntu 装 fonts-noto-cjk 后即为下面路径）
FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ---------- Kindle 端必填 ----------
# 仪表盘图片完整 URL：YOUR_DOMAIN 换成你的域名，YOUR_TOKEN 换成随机串（openssl rand -hex 8）
# 注意：YOUR_TOKEN 必须与 nginx 配置里的路径一致
IMAGE_URL=http://YOUR_DOMAIN/kindle-dash-YOUR_TOKEN/dash.png

# ---------- 可选（有默认值，一般不用改） ----------
# 服务器渲染间隔 / Kindle 拉取间隔（秒）
FETCH_INTERVAL=60
# Kindle 每刷新多少次后做一次全刷清残影
FULL_REFRESH_EVERY=60
# 时钟/日历使用的时区
TIMEZONE=Asia/Shanghai
